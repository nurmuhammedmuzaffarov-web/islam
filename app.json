{
  "expo": {
    "name": "Islam",
    "slug": "islam",
    "scheme": "islam",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5EFE4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.islam.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Намаз убактысын жана кыбланы аныктоо үчүн жайгашкан жериңиз керек."
      }
    },
    "android": {
      "package": "kg.islam.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        { "backgroundColor": "#F5EFE4", "image": "./assets/splash-icon.png", "imageWidth": 160 }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Намаз убактысын жана кыбланы аныктоо үчүн жайгашкан жериңиз керек." }
      ],
      ["expo-notifications", { "color": "#1F7A5C" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
